        <mxCell id="tp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;align=left;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;line-height:1.25;background:#ffffff;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;background:#82b366;color:#ffffff;font-weight:bold;font-size:12px;&quot;&gt;Tests · Per pupil — pupils.csv&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;font-weight:bold;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;width:41%;&quot;&gt;Metric&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;What it means&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;n_items / closed_items&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Questions answered / questions scored automatically&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;closed_correct / closed_points / closed_max_points&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Score on the auto-scored questions&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;open_pending&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Open answers waiting for coding (scored later with the K1–K3 rubric)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_n&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Questions with a confidence rating&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_bias&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Over- or under-confidence on the test&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_absolute_accuracy&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;How far confidence is from actual performance&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_brier&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Calibration error (0 = perfect)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_gamma&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Does the pupil know which answers are right (resolution)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;calib_sensitivity&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;How well confidence picks out the correct answers&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;rte_nt10 / rte_fixed / rte_bimodal&lt;/span&gt; &lt;span title=&quot;time-based&quot;&gt;⏱&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Response-time effort: share of questions answered with real effort, not rapid guessing (three threshold methods)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;below_effort_floor&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Pupil flagged as not really trying&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;integrity_families / integrity_excluded&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Suspicious answer patterns triggered / pupil excluded&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
