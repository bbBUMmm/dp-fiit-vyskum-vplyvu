        <mxCell id="tq" parent="1" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;align=left;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;line-height:1.25;background:#ffffff;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;background:#82b366;color:#ffffff;font-weight:bold;font-size:12px;&quot;&gt;Tests · Per question — scored.csv&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#d5e8d4;font-weight:bold;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;width:41%;&quot;&gt;Metric&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;What it means&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;seconds&lt;/span&gt; &lt;span title=&quot;time-based&quot;&gt;⏱&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Time spent on the question&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;correct&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Whether the answer was correct&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;points / max_points&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Score (2/1/0 for closed questions) and maximum&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;response / chosen&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;What the pupil answered or picked&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;diagnosis&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;The misconception behind a wrong option&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;jol&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Confidence in this answer (0–100)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;level / skill&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Bloom level and skill the question measures&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;anchor&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Question repeated in T3 and T4 (for retention)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;&lt;span style=&quot;font-family:Consolas,&#39;Courier New&#39;,monospace;word-break:break-word;&quot;&gt;pending&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #b7d4a8;padding:3px 6px;vertical-align:top;&quot;&gt;Open answer waiting for human coders&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
