        <mxCell id="ts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;align=left;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;line-height:1.25;background:#ffffff;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;background:#d79b00;color:#ffffff;font-weight:bold;font-size:12px;&quot;&gt;Questionnaires · In every test sitting&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc;font-weight:bold;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;width:41%;&quot;&gt;Instrument&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;What it means&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Self-efficacy (part P, T1 and T3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;„How sure am I that I can solve …“, 0–100&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;D0 (once, before T1)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;AI use, trust in AI, offloading habits, need for cognition (NFC-6)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;D1 (with T1)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Prior exposure to the topic, interest in the subject, AI use in the subject&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;D3 (with T3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Mental effort (Paas), cognitive load (Leppink, 10 items), interest, feeling of learning, judgement of learning 0–100, assistant questions incl. manipulation checks&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;D4 (with T4)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Revised at home? Used AI? Expected the test? Interest&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8f9fb;&quot;&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Z (after every test)&lt;/td&gt;&lt;td style=&quot;border:1px solid #f0c88a;padding:3px 6px;vertical-align:top;&quot;&gt;Predicted own score, effort on the test, test-taking effort&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
