<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quiet down the Netty / LittleProxy internals; we only want their warnings. -->
    <logger name="io.netty" level="WARN"/>
    <logger name="org.littleshoot.proxy.impl" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
